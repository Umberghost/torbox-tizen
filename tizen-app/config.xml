<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/Umberghost/torbox-tizen" version="1.1.0" viewmodes="maximized">
    <access origin="*" subdomains="true"/>
    <tizen:application id="TrBxApp001.TorBox" package="TrBxApp001" required_version="3.0"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <feature name="http://tizen.org/feature/web.service"/>
    <icon src="icon.png"/>
    <name>Faro</name>
    <description>Faro (cliente no oficial para TorBox y Real-Debrid): biblioteca, búsqueda, TV en directo. El código se actualiza solo desde GitHub.</description>
    <tizen:metadata key="http://samsung.com/tv/metadata/prelaunch.support" value="true"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/html5.4k.support" value="true"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/unlimitedstorage"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:service id="TrBxApp001.Service">
        <tizen:content src="service.js"/>
        <tizen:name>FaroService</tizen:name>
        <tizen:description>Proxy CORS y web de ajustes de Faro</tizen:description>
    </tizen:service>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
